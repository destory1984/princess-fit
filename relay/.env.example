# relay/.env 로 베껴서 채운다. relay/.env 는 저장소에 올라가지 않는다(.gitignore).
# service-role 키는 모든 사용자의 모든 기록을 지울 수 있다. 이 PC 밖으로 내보내지 않는다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ollama. 끄면(false) Codex만 쓴다.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_MS=25000

# ChatGPT CLI(codex exec)로 넘어가도 되는 사람: none | admins | all
# Codex는 이 PC의 파일을 읽을 수 있는 일꾼이라, 남의 글을 넣는 것은 조심한다. docs/relay.md 참고.
CODEX_SCOPE=admins
CODEX_MODEL=
CODEX_TIMEOUT_MS=60000

POLL_MS=1500
