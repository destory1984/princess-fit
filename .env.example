EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local model for the post-workout advice. Falls back to built-in rules if the
# server is unreachable. Use the PC's LAN IP, not localhost, to reach it from a phone.
EXPO_PUBLIC_ADVICE_URL=http://localhost:11434/api/generate
EXPO_PUBLIC_ADVICE_MODEL=qwen3.8:27b

# 자체 SMTP를 붙여 메일이 실제로 갈 때만 on. 로그인 화면에 비밀번호 찾기와 인증 메일 다시 보내기가 뜬다.
# EXPO_PUBLIC_MAIL=on
