{
  "expo": {
    "name": "프린세스 핏",
    "slug": "refit",
    "scheme": "refit",
    "version": "0.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.refit.app"
    },
    "android": {
      "package": "com.refit.app",
      "adaptiveIcon": {
        "backgroundColor": "#C4F87E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "걸음 수를 세어 리나에게 알려 주려고 해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/princess-fit"
    }
  }
}
